{
  "name": "campus-lost-and-found-app",
  "version": "1.0.0",
  "description": "Campus Lost and Found application - Vue 3 + Express + SQLite",
  "scripts": {
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "open:app": "open http://localhost:3001",
    "open:dev": "open http://localhost:5173"
  },
  "keywords": [
    "campus",
    "lost-and-found",
    "vue3",
    "vite",
    "sqlite",
    "express"
  ],
  "author": "",
  "license": "ISC"
}
